          "docs": "gets unique trading symbol identifiers for implied volatility"
        },
        {
          "info": {
            "name": "gets symbols for realized volatility",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v1/aidataset/RV/"
          },
          "docs": "gets unique trading symbol identifiers for realized volatility"
        },
        {
          "info": {
            "name": "gets symbols for implied dividend flow",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v1/aidataset/DIV/"
