        {
          "id": "86e3516f-9b2f-4ba3-942c-8bcbef6d4249",
          "name": "retrieves list of packets' sending times, or complete packets",
          "request": {
            "name": "retrieves list of packets' sending times, or complete packets",
            "description": {
              "content": "The request delivers a list of the available sending times, or alternatively complete packets for the selected exchange, trading day, asses and security.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "mdp",
                ":exchange",
                ":date",
                ":asset",
                ":securityId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "mode",
                  "value": "reference",
                  "description": "Define the output format for the response.<br/> Mode options:\n  * `reference` (default) - Shows a list of the referencing IDs\n  * `detailed` - Shows a list of packets with messages including their details\n"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "1000",
                  "description": "max number of elements in the response"
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<string>,<string>",
                  "description": "array of packet's sending times as start times for (multiple) time interval selection (multiple values are separated by comma)"
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<string>",
                  "description": "packet's sending time as a global end time for (multiple) time interval selection"
                },
                {
                  "disabled": false,
                  "key": "msgSeqNum",
                  "value": "<long>,<long>",
                  "description": "array of packet's sequence numbers used as a filter to select packets (multiple values are separated by comma)"
                },
                {
                  "disabled": false,
                  "key": "templateId",
                  "value": "<integer>,<integer>",
                  "description": "array of templateIDs used as a filter to select packets (multiple values are separated by comma)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "exchange",
                  "description": "(Required) exhange identifier code"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "date",
                  "description": "(Required) trading day in the format YYYYMMDD"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "asset",
                  "description": "(Required) unique asset identifier"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "securityId",
                  "description": "(Required) unique security identifier"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
