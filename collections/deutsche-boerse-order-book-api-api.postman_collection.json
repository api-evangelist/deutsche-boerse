          "name": "Retrieve order books for T7",
          "request": {
            "name": "Retrieve order books for T7",
            "description": {
              "content": "The request delivers either the order book valid at a given time or a list of order books for a given time period.</br> If `limit` is equal to `1`, the response will contain a single order book otherwise the response will contain a list of order books.</br> If `from` query parameter is not provided, the first order book of the day will be returned.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ob",
                ":marketId",
                ":date",
                ":marketSegmentId",
                ":securityId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "0",
                  "description": "Timestamp of when the order book was valid or starting time of the time interval.<br/> Format: Nanoseconds since 1970 (EOBI TransactTime)\n"
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "9999999999999999999",
                  "description": "Ending time of the time interval.<br/> Format: Nanoseconds since 1970 (EOBI TransactTime) \n"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "1",
                  "description": "Max number of elements in the response (Minimum = 1 / Maximum = 10000)."
                },
                {
                  "disabled": false,
                  "key": "levels",
                  "value": "10",
                  "description": "Define depth of the order book."
                },
                {
                  "disabled": false,
                  "key": "orderbook",
                  "value": "aggregated",
                  "description": "Define if orders should be shown or aggregated.</br> Mode options:\n  * aggregated = Aggregate orders\n  * complete = Display orders\n"
                },
                {
                  "disabled": false,
                  "key": "trades",
                  "value": "false",
                  "description": "Display trades."
                },
                {
                  "disabled": false,
                  "key": "indicatives",
                  "value": "false",
                  "description": "Indicative auction uncrossing."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "marketId",
                  "description": "(Required) Market identifier code as specified in ISO 10383."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "date",
                  "description": "(Required) Trading day in the format  YYYYMMDD"
                },
                {
                  "disabled": false,
